# Local Postgres (system install):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gofam_grow?schema=public
#
# Or Prisma local Postgres (no Docker required):
#   npx prisma dev --name gofam-grow --detach
# Then use the TCP URL it prints (port is often NOT 5432), e.g.:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:51214/gofam_grow?schema=public&sslmode=disable&connect_timeout=30
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
# Refresh token lifetime — default 60d (client sanity-check range: 30–90d for adults)
JWT_REFRESH_EXPIRES=60d
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
# Client-visible deploy tier (staging | demo | production). When set, blocks dev-placeholder GAP copy
# and invalid GAP ↔ mission-group mapping (see npm run check:gap -w @gofam/api).
# GOFAM_DEPLOY_ENV=staging
# Same OAuth 2.0 Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
