{
  "name": "@gofam/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/dev-api.mjs",
    "dev:watch-only": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "test": "tsx --test src/**/*.test.ts",
    "check:gap-content": "tsx scripts/check-gap-content.ts",
    "check:gap-mapping": "tsx scripts/check-gap-mapping.ts",
    "check:gap-reverse": "node scripts/audit-gap-reverse-items.mjs --ci",
    "check:gap": "npm run check:gap-mapping && npm run check:gap-reverse && npm run check:gap-content",
    "gap:audit": "node scripts/audit-gap-mission-mapping.mjs",
    "gap:generate": "node scripts/generate-gap-from-missions.mjs",
    "seed:step-demo": "tsx scripts/seed-step-demo.ts",
    "seed:geo": "tsx scripts/seed-geo.ts",
    "seed:geo-force": "tsx scripts/seed-geo-force.ts",
    "screenshots:step": "node scripts/capture-step-screenshots.mjs",
    "missions:extract": "node scripts/extract-missions-from-docx.mjs",
    "missions:preview": "tsx scripts/import-missions.ts --dry-run",
    "missions:import": "tsx scripts/import-missions.ts",
    "migrate:journey-v2": "tsx scripts/migrate-journey-v2.ts",
    "migrate:journey-v2:dry-run": "tsx scripts/migrate-journey-v2.ts --dry-run",
    "rollback:journey-v2": "tsx scripts/rollback-journey-v2.ts",
    "check:flow-lockstep": "tsx scripts/check-flow-lockstep-consistency.ts",
    "seed:cutover-test": "tsx scripts/seed-journey-v2-cutover-test.ts",
    "verify:journey-v2-cutover": "tsx scripts/verify-journey-v2-cutover.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@countrystatecity/countries": "^1.0.9",
    "@gofam/shared-types": "*",
    "@prisma/client": "^6.3.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "otplib": "^13.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
